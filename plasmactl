def menu():
    while True:
        header()
        print()
        print(f"  {CYAN}[1]{NC} {'backup':<9} salva temi e configurazione attuali")
        print(f"  {CYAN}[2]{NC} {'reset':<9} ripristina kde ai default breeze")
        print(f"  {CYAN}[3]{NC} {'restore':<9} ripristina selettivamente da backup")
        print()
        print(f"  {CYAN}[0]{NC} {'exit':<9}")
        print()
        choice = input("  >> ").strip()

        if choice in ('backup', '1'):
            backup()
        elif choice in ('reset', '2'):
            reset()
        elif choice in ('restore', '3'):
            restore()
        elif choice in ('exit', '0', 'q'):
            os.system('clear')
            print("plasmactl")
            print("────────────────────────────────────────────")
            print()
            break
        else:
            print()
            print(f"  {ERR} comando non valido")
            time.sleep(1)


